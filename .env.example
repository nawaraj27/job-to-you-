# Copy to .env and adjust. Never commit .env.
#
# Development defaults match docker-compose.yml, so an empty .env works locally.
# Production supplies every value; config/settings/prod.py refuses to start
# without SECRET_KEY, ALLOWED_HOSTS and POSTGRES_PASSWORD.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- database ------------------------------------------------------------
POSTGRES_DB=careerai
POSTGRES_USER=careerai
POSTGRES_PASSWORD=careerai
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- cache, sessions, broker --------------------------------------------
# One Redis instance, three logical databases (ADR-A35): /0 broker, /1 cache,
# /2 session cache. The split is for namespace isolation and monitoring —
# `cache.clear()` must not reach sessions. Nothing durable lives in Redis:
# single-use tokens are in PostgreSQL and sessions use cached_db.
REDIS_URL=redis://127.0.0.1:6380
REDIS_BROKER_URL=redis://127.0.0.1:6380/0
REDIS_CACHE_URL=redis://127.0.0.1:6380/1
REDIS_SESSION_URL=redis://127.0.0.1:6380/2
CELERY_BROKER_URL=redis://127.0.0.1:6380/0

# --- security baseline ---------------------------------------------------
RATELIMIT_ENABLED=1
# CSP is enforced by default. Set to 1 only to validate a policy change.
CSP_REPORT_ONLY=0

# --- files ---------------------------------------------------------------
# AllowAllScanner is the development default and is refused when DEBUG is off.
FILES_SCANNER=apps.files.scanning.AllowAllScanner
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
FILES_MAX_UPLOAD_BYTES=10485760
FILES_SIGNED_URL_MAX_AGE=300
# PRIVATE_STORAGE_ROOT=/var/lib/careerai/private

# --- outbox --------------------------------------------------------------
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_HOURS=24
OUTBOX_POLL_SECONDS=2

LOG_LEVEL=INFO

# --- field encryption (ADR-A45) ------------------------------------------
# Fernet keys, newest first, comma separated. Rotation adds a key at the front
# and keeps the old one until everything is re-encrypted. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. Losing every key means losing phone numbers, MFA
# secrets and webhook signing secrets — they are encrypted, not hashed.
FIELD_ENCRYPTION_KEYS=

# --- AI providers (ADR-A28: routing is code, credentials are not) --------
# OpenRouter is the hosted chain; Ollama is the local fallback. With neither
# set, every AI feature degrades to its deterministic half rather than failing
# (SRS §9.3.6), which is a supported way to run the platform.
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# How long Ollama keeps a model loaded after a call. Loading the 7B model takes
# 11-17 s on a CPU, so a short value makes every quiet-period call slow.
# OLLAMA_KEEP_ALIVE=30m

# --- email ---------------------------------------------------------------
# Development prints to the console. Production must set a real host, or
# nothing the platform promises to send is sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=CareerAI <hello@careerai.test>

# --- TLS and origins (production) ----------------------------------------
# Behind a TLS-terminating proxy. Both are required in production: without the
# trusted origins, every cross-origin POST fails CSRF; without the redirect,
# the site answers on plain HTTP.
DJANGO_CSRF_TRUSTED_ORIGINS=https://careerai.example
DJANGO_SECURE_SSL_REDIRECT=1

# --- rendering -----------------------------------------------------------
# Where the PDF renderer looks for its font files (ADR-A50).
# RENDER_FONT_DIR=/usr/share/fonts/truetype/careerai

# --- billing -------------------------------------------------------------
# Only used by the in-process test gateway (ADR-A55).
BILLING_FAKE_PROVIDER_SECRET=fake-provider-secret

# --- payment gateways, sandbox only (ADR-A58) ----------------------------
# Only "test" is accepted; `manage.py check` refuses anything else (billing.E001).
PAYMENTS_ENVIRONMENT=test
# eSewa ePay v2 UAT. eSewa publishes its UAT product code and secret key on
# https://developer.esewa.com.np/pages/Epay - copy them from there into .env.
# Sandbox login (also published there) is entered by you on eSewa's page.
ESEWA_ENABLED=false
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
# ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
# Khalti KPG-2 sandbox. The key is issued per merchant after signing up at
# https://test-admin.khalti.com (use its "live_secret_key"). No shared key exists.
KHALTI_ENABLED=false
KHALTI_SECRET_KEY=
# KHALTI_BASE_URL=https://dev.khalti.com/api/v2/

# --- database connection reuse -------------------------------------------
POSTGRES_CONN_MAX_AGE=60

# --- Celery time limits --------------------------------------------------
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# --- remaining tunables --------------------------------------------------
# Every one has a working default in config/settings; they are listed so a
# reader can see the full surface rather than discovering it in an incident.
CLAMAV_TIMEOUT=10
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
IDEMPOTENCY_TTL_SECONDS=86400
PASSWORD_RESET_TIMEOUT=3600
# Overrides the email backend. Development uses the console backend; setting
# this to a real backend without EMAIL_HOST sends nothing, silently.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- live interviews: Jitsi as a Service (8x8 JaaS) -------------------------
# Leave unset in development (the fake provider is used). Production requires
# all four; `manage.py check --deploy` fails without them. In the JaaS console,
# upload the public half of the key, copy its key id, and require authentication
# so a room URL without a signed token is refused.
# VIDEO_ROOM_PROVIDER=apps.interviews.providers.jitsi.JitsiRoomProvider
# JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# JAAS_API_KEY_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/abc123
# JAAS_PRIVATE_KEY_PATH=/run/secrets/jaas_private_key.pem
# Or the key itself, when a secret store injects it as a variable:
# JAAS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# Only for a non-default JaaS region or deployment.
# JAAS_BASE_URL=https://8x8.vc

# --- spoken practice interviews ---------------------------------------------
# Empty uses local faster-whisper when installed. Model weights (~145 MB for
# base.en) download on first use; pre-fetch them in the image build.
# SPEECH_TO_TEXT_MODEL=base.en
# Dotted path of the transcriber; empty means local faster-whisper when installed.
# SPEECH_TO_TEXT_PROVIDER=apps.interviews.speech.local.FasterWhisperTranscriber

# --- tests only --------------------------------------------------------------
# A separate test database, so two test runs (a focused one and the full suite)
# do not drop each other's database.
# CAREERAI_TEST_DB_NAME=test_careerai_full
